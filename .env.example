# Copy to .env and fill in. Never commit .env.

# Primary inference: Vultr Serverless Inference (OpenAI-compatible)
VULTR_API_KEY=
VULTR_BASE_URL=
VULTR_MODEL=

# Fallback inference (transient failures only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# HTTP Basic Auth for write endpoints (POST/PATCH)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me

# Storage
DB_PATH=/data/reconcileiq.db

# Public hostname used by Caddy for TLS. Must be the full DuckDNS name
# (e.g. myapp.duckdns.org) and resolve to the VM, or Caddy serves 'localhost'
# and cannot get a certificate. Leave blank for local runs.
PUBLIC_HOST=
