# Copy to .env and fill in. Never commit .env.

# Primary inference: Vultr Serverless Inference (OpenAI-compatible)
VULTR_API_KEY=
VULTR_BASE_URL=
VULTR_MODEL=

# Fallback inference (transient failures only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# HTTP Basic Auth for write endpoints (POST/PATCH)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Storage
DB_PATH=/data/reconcileiq.db

# Public hostname (DuckDNS) used by the reverse proxy for TLS
PUBLIC_HOST=
